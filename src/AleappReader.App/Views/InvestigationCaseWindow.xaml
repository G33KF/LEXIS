<Window x:Class="AleappReader.App.Views.InvestigationCaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Investigation case" Height="520" Width="760" WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource ViewTitle}" Text="Investigation case"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"
                       Text="The reports of several devices opened together: a joint timeline and map, co-presence, common contacts and one search over all of them. The .lexiscase file only lists the reports; tags stay with each report."/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Proceeding no." VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Grid.Column="3" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
            </Grid>
            <DockPanel Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Content="Add report folder…" Command="{Binding AddFolderCommand}"/>
                    <Button Style="{StaticResource FlatButton}" Content="Add file or portable case…" Command="{Binding AddFileCommand}"/>
                    <Button Style="{StaticResource FlatButton}" Content="Remove" Command="{Binding RemoveCommand}"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center"><Run Text="Devices" FontWeight="SemiBold"/><Run Text="  ·  click a label to rename the device (shown in the tree, tabs and joint views)" Foreground="{StaticResource MutedBrush}"/></TextBlock>
            </DockPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Cancel" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Save and open" Command="{Binding SaveCommand}" IsDefault="True"/>
            <TextBlock Text="{Binding Message}" Foreground="#B3261E" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                  GotFocus="Grid_GotFocus">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                <DataGridTemplateColumn Header="Colour" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Palette, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Color, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><Border Width="60" Height="14" CornerRadius="2" Background="{Binding}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Report" Binding="{Binding Path}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
