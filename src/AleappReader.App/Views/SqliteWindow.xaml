<Window x:Class="AleappReader.App.Views.SqliteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, StringFormat={}{0} · SQLite reader (read-only copy)}" Width="1280" Height="820"
        WindowStartupLocation="CenterOwner" Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Style="{StaticResource ViewTitle}" Text="{Binding Title}"/>
                <TextBlock Text="{Binding Origin}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FileInfo}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox Content="Apply the write-ahead log" IsChecked="{Binding ApplyWal}" IsEnabled="{Binding HasWal}" VerticalAlignment="Center"
                              ToolTip="Checked: what the app saw last (mode=ro). Unchecked: the main file alone (immutable=1), as before the log's transactions"/>
                    <TextBlock Text="{Binding WalText}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TagTextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="12,4" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <DockPanel>
                <TextBox DockPanel.Dock="Bottom" Text="{Binding Schema, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="200" FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Schema of the selected object"/>
                <ListBox ItemsSource="{Binding Objects}" SelectedItem="{Binding Selected}" BorderThickness="0" AutomationProperties.Name="Tables, views and indexes">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Rows, StringFormat=N0}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                                <TextBlock><Run Text="{Binding Type, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/> <Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <DockPanel Grid.Column="2">
                <WrapPanel DockPanel.Dock="Top" Margin="6,6,6,2">
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                             ToolTip="Filter the table's rows (Enter): words, a | b, -word, &quot;phrase&quot;, /regex/">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ShowTableCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource FlatButton}" Content="Table" Command="{Binding ShowTableCommand}" ToolTip="The selected table's rows"/>
                    <Button Style="{StaticResource FlatButton}" Content="◀" Command="{Binding PreviousCommand}" ToolTip="Previous 500 rows"/>
                    <Button Style="{StaticResource FlatButton}" Content="▶" Command="{Binding NextCommand}" ToolTip="Next 500 rows"/>
                    <Button Style="{StaticResource FlatButton}" Content="Recovered (table)" Command="{Binding CarveCommand}" CommandParameter="table" Margin="12,2,2,2"
                            ToolTip="Records of the selected table that a query no longer returns: older page versions (main file and WAL frames), free space, rollback journal"/>
                    <Button Style="{StaticResource FlatButton}" Content="Recovered (all tables)" Command="{Binding CarveCommand}" CommandParameter="all"/>
                    <Button Style="{StaticResource FlatButton}" Content="Export CSV…" Command="{Binding ExportCsvCommand}" Margin="12,2,2,2"/>
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="8,0" Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                </WrapPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="6,2,6,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Run" Command="{Binding RunSqlCommand}" VerticalAlignment="Top"
                            ToolTip="One SELECT, WITH, PRAGMA or EXPLAIN, on a read-only, query_only connection to the copy (Ctrl+Enter)"/>
                    <TextBox Text="{Binding Sql, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" FontFamily="Consolas" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="SQL (read-only)">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding RunSqlCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Notes}" Margin="6,2" TextWrapping="Wrap" Foreground="{StaticResource TagTextBrush}"/>
                <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="Cell" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          CanUserSortColumns="True" Sorting="OnSorting" CurrentCellChanged="OnCurrentCellChanged" AutomationProperties.Name="Rows"/>
            </DockPanel>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>
            <DockPanel Grid.Column="4">
                <Image DockPanel.Dock="Top" Source="{Binding CellImage}" MaxHeight="260" Stretch="Uniform" Margin="6"/>
                <TextBox Text="{Binding Cell, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" BorderThickness="0"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected cell, decoded"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
