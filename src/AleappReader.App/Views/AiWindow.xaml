<Window x:Class="AleappReader.App.Views.AiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AleappReader.App.ViewModels"
        xmlns:app="clr-namespace:AleappReader.App"
        Title="AI analysis" Height="760" Width="1180" WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource ViewTitle}" Text="AI analysis"/>
            <TextBlock Text="{Binding ScopeText}" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StoreText}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StoreText}"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Close" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="AI settings" Command="{Binding OpenSettingsCommand}" IsEnabled="{Binding Idle}" Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Stop" Command="{Binding CancelCommand}" Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
            <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" IsIndeterminate="True" Margin="8,0" Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel IsEnabled="{Binding Idle}">
                    <Button Command="{Binding CompleteAnalysisCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,10" Padding="10,6"
                            Background="#2B2B2B" Foreground="White" BorderThickness="0"
                            ToolTip="Choose the data categories and write the objective: the AI reads all their records (and, if asked, translates, describes pictures, transcribes audio first), keeps what bears on the objective and writes a cited report">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💀" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="  COMPLETE ANALYSIS" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Nothing here for the AI: no records, data, images or audio it can read, and the Claude CLI is not allowed in AI settings."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="{Binding HasNothing, Converter={StaticResource Vis}}"/>
                    <StackPanel Visibility="{Binding HasData, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="The data shown"/>
                        <TextBlock Text="{Binding TextModel, StringFormat=Model: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource FlatButton}" Content="Explain it (what it is, each value)" Command="{Binding ExplainDataCommand}" IsEnabled="{Binding Text, Source={x:Static app:AiState.Instance}}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasRecords, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Read the records"/>
                        <TextBlock Text="{Binding TextModel, StringFormat=Model: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource FlatButton}" Content="Summarize" Command="{Binding SummarizeCommand}" Visibility="{Binding CanSummarize, Converter={StaticResource Vis}}" IsEnabled="{Binding Text, Source={x:Static app:AiState.Instance}}" HorizontalAlignment="Left"/>
                        <Button Style="{StaticResource FlatButton}" Content="Explain every technical value" Command="{Binding ExplainCommand}" IsEnabled="{Binding Text, Source={x:Static app:AiState.Instance}}" HorizontalAlignment="Left"
                                ToolTip="What each record is and what each of its values means; shown in each record's details, in the AI section"/>
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding CanTranslate, Converter={StaticResource Vis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Translate" Command="{Binding TranslateCommand}" IsEnabled="{Binding Text, Source={x:Static app:AiState.Instance}}"/>
                            <TextBlock DockPanel.Dock="Left" Text="Into" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Search the records" Margin="0,12,0,4"/>
                        <TextBlock Text="Question"/>
                        <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
                        <DockPanel Margin="0,4,0,0">
                            <CheckBox DockPanel.Dock="Right" Content="Web search" IsChecked="{Binding WebSearch}" VerticalAlignment="Center"
                                      ToolTip="Questions and Explain search the web first. The words searched are shown before they leave (words with digits or @ dropped) and logged; the results are reference, not evidence, and the answer marks what rests on them with (web: address)."/>
                            <Button Style="{StaticResource FlatButton}" Content="Ask about these records" Command="{Binding AskQuestionCommand}" IsEnabled="{Binding Text, Source={x:Static app:AiState.Instance}}" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <TextBlock Text="Thematic review" Margin="0,10,0,2"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Review" Command="{Binding ThematicReviewCommand}" IsEnabled="{Binding Text, Source={x:Static app:AiState.Instance}}"
                                    ToolTip="In batches of 30 records; stopped, it resumes where it left off"/>
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Name"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Theme.Indicators}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasImages, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Images"/>
                        <TextBlock Text="{Binding VisionModel, StringFormat=Model: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource FlatButton}" Content="{Binding ImagesText}" Command="{Binding ClassifyImagesCommand}" IsEnabled="{Binding Vision, Source={x:Static app:AiState.Instance}}" HorizontalAlignment="Left"
                                ToolTip="JPEG, PNG, GIF and WebP; one category per image with a confidence. Stopped, it resumes"/>
                        <Button Style="{StaticResource FlatButton}" Content="Describe and read the text (OCR)" Command="{Binding DescribeImagesCommand}" IsEnabled="{Binding Vision, Source={x:Static app:AiState.Instance}}" HorizontalAlignment="Left"
                                ToolTip="What each image shows, its text as written, and that text translated into the answer language. Stopped, it resumes"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SkippedText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding SkippedText, Converter={StaticResource Vis}}"/>
                    <StackPanel Visibility="{Binding HasVideos, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Video"/>
                        <TextBlock Text="{Binding VideoModel, StringFormat=Model: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource FlatButton}" Content="{Binding VideosText}" Command="{Binding AnalyseVideosCommand}" IsEnabled="{Binding Video, Source={x:Static app:AiState.Instance}}" HorizontalAlignment="Left"
                                ToolTip="Frames taken as set in AI settings › Video, each described; the audio track transcribed; one timeline per video"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasAudio, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Audio"/>
                        <TextBlock Text="{Binding TranscriptionModel, StringFormat=Model: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource FlatButton}" Content="{Binding AudioText}" Command="{Binding TranscribeCommand}" IsEnabled="{Binding Audio, Source={x:Static app:AiState.Instance}}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ClaudeAllowed, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Claude CLI"/>
                        <TextBlock Text="Leaves this machine: asks before each run. Uses the question above; Claude reads the case through LEXIS's read-only tools."
                                   Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasRecords, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                        <Button Style="{StaticResource FlatButton}" Content="Ask Claude (CLI)" Command="{Binding AskClaudeCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <TabControl Grid.Column="1">
                <TabItem Header="Results">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DockPanel>
                        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Kinds}" SelectedItem="{Binding KindFilter}" Margin="0,0,0,4" ToolTip="Show one kind of result only"/>
                        <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="{Binding EmptyText}"
                                   Visibility="{Binding HasSelected, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                        <DockPanel Grid.Column="1" Margin="10,0,0,0" Visibility="{Binding HasSelected, Converter={StaticResource Vis}}">
                            <TextBlock DockPanel.Dock="Top" Text="{x:Static vm:AiViewModel.Caveat}"
                                       FontWeight="SemiBold" Foreground="#B26A00" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoftBrush}" Padding="8,5" CornerRadius="3">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Copy" Command="{Binding CopyResultCommand}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selected.Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Selected.Scope, StringFormat=Over: {0}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Expander DockPanel.Dock="Top" Header="Prompt" Margin="0,4,0,0">
                                <TextBox Text="{Binding Selected.Prompt, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/>
                            </Expander>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding UnknownText}" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding UnknownText, Converter={StaticResource Vis}}"/>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Cited records (click to open)" Foreground="{StaticResource MutedBrush}"/>
                                <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Selected.Cited}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FlatButton}" Content="{Binding}" Margin="0,2,4,0"
                                                        Command="{Binding DataContext.OpenCiteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <TextBox Text="{Binding Selected.Output, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                     FontFamily="Segoe UI" FontSize="13"/>
                        </DockPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Send log">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="200"/></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Sends}" SelectedItem="{Binding SelectedSend}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When (UTC)" Binding="{Binding At, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="140"/>
                                <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="70"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="140"/>
                                <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="*"/>
                                <DataGridTextColumn Header="Characters" Binding="{Binding Sent.Length, StringFormat=N0}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Grid.Row="1" Margin="0,6,0,0" Text="{Binding SelectedSend.Sent, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 ToolTip="Exactly what was sent"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
